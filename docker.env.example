# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your-azure-embedding-api-key

# Database Configuration (using Docker defaults)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/b2b_sales

# Elasticsearch Configuration (using Docker defaults)
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# Application Configuration
API_HOST=0.0.0.0
API_PORT=3001
DEBUG=true
USE_HYBRID_RETRIEVER=true
FORCE_RELOAD_DATA=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# AI Service Configuration
DEFAULT_AI_PROVIDER=azure_openai
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# ChromaDB Configuration
CHROMA_DB_PATH=/app/chroma_db
CHROMA_MAX_ITEMS_PER_FILE=50

# Data Configuration
DATA_DIR=Data/json
SKIP_DATA_LOADING=false
ELASTICSEARCH_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# Proxy Configuration (if needed)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=eleven_multilingual_v1
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.5
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# Speech Service Configuration
SPEECH_PRIMARY_PROVIDER=elevenlabs
SPEECH_FALLBACK_ENABLED=true
SPEECH_TTS_PRIMARY_RETRIES=1

# New Relic Configuration
NEWRELIC_ENABLED=True
NEWRELIC_LICENSE_KEY=your_newrelic_license_key_here
NEWRELIC_APP_NAME=B2B Sales Backend
NEWRELIC_ENVIRONMENT=production
NEWRELIC_DISABLE_FOR_ELASTICSEARCH=True

# Performance Configuration
ENABLE_RESPONSE_CACHING=True
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=b2b_sales
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/b2b_sales

# Database Performance Settings
DB_ECHO_SQL=False
CONVERSATION_HISTORY_LIMIT=20

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PRODUCTS=products
ELASTICSEARCH_INDEX_SOLUTIONS=solutions

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# RRF configuration
USE_RRF_MERGING=True
RRF_K=60.0
RRF_ELASTICSEARCH_WEIGHT=0.5
RRF_SEMANTIC_WEIGHT=0.5

# Search result configuration
MAX_SEARCH_RESULTS_PER_SOURCE=50
FINAL_RESULT_LIMIT=20