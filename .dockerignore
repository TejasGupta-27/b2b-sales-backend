# Safe default dockerignore
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.sqlite3
.env
logs/
test_outputs/
.git

# Database data directories (should not be included in build context)
postgres_data/
elasticsearch_data/

# Development and temporary files
.DS_Store
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/

# Test files
test_*.py
*_test.py

# Documentation
*.md
!README.md

# Monitoring and optional services
monitoring/
docker-compose.monitoring.yml
